# --- Core ---
PORT=5001
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
NODE_ENV=production

# --- Clerk ---
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AWS ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
S3_BUCKET_NAME=secondlife-marketplace-uploads
S3_UPLOAD_PREFIX=uploads

# --- Gemini ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL_PRIMARY=gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-2.0-flash

# --- KMS / Signing ---
KMS_KEY_ID=
KMS_KEY_ALIAS=secondlife-health-card-signing
PRIVATE_KEY_ED25519=
PUBLIC_KEY_ED25519=

# --- Service URLs (production) ---
ML_SERVICE_URL=https://second-life-ml.onrender.com
FRONTEND_URL=https://second-life-tau.vercel.app
BACKEND_URL=https://second-life-api.onrender.com
CORS_ORIGINS=https://second-life-tau.vercel.app,https://second-life-ml.onrender.com,https://second-life-api.onrender.com

# --- App Config ---
UPLOAD_MAX_SIZE_MB=10
GRADE_CACHE_TTL_SECONDS=3600
