# ── Root environment template ───────────────────────────────────────────────
# Copy blocks into backend/.env, ml-service/.env, and frontend/.env.
# Production URLs are live — swap secrets only.

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=secondlife-marketplace-uploads
S3_UPLOAD_PREFIX=uploads
KMS_KEY_ID=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-2.0-flash

# Services (production)
ML_SERVICE_URL=https://second-life-ml.onrender.com
FRONTEND_URL=https://second-life-tau.vercel.app
BACKEND_URL=https://second-life-api.onrender.com
CORS_ORIGINS=https://second-life-tau.vercel.app,https://second-life-ml.onrender.com,https://second-life-api.onrender.com

# Backend
PORT=5001
NODE_ENV=production

# Auth (Clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Frontend (Vite / Vercel)
VITE_API_URL=https://second-life-api.onrender.com/api
VITE_CLERK_PUBLISHABLE_KEY=

# Deploy targets:
#   Frontend → Vercel  (root: frontend/)  https://second-life-tau.vercel.app
#   Backend  → Render  (root: backend/)   https://second-life-api.onrender.com
#   ML       → Render  (root: ml-service/) https://second-life-ml.onrender.com
